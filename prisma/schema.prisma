
  generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
    output = "../app/generated/prisma"
  }

  datasource db {
    provider = "mongodb"
    url = env("DATABASE_URL")
  }

  model User {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    name         String
    email        String   @unique
    passwordHash String?
    pass         String?
    avatarUrl    String?  @default("https://res.cloudinary.com/dylkeqcms/image/upload/v1762125098/default_uqhrk3.jpg")
    username     String?  @unique
    bio          String?
    bannerUrl    String?
    currentBookId String? @db.ObjectId
    favoriteBookId String? @db.ObjectId
    timezone     String   @default("America/Sao_Paulo")
    accentColor  String   @default("#ffffff")
    appAccentColor String @default("#ffffff")
    appColorPresets AppColorPreset[]
    tokenVersion Int      @default(0)
    quotaVersion Int?     @default(0)
    readingFocusBookId String? @db.ObjectId
    readingFocusSessionId String?
    readingFocusUpdatedAt DateTime?
    emailVerifiedAt DateTime?
    emailVerificationRequired Boolean @default(false)
    emailVerificationCodeHash String?
    emailVerificationExpiresAt DateTime?
    emailVerificationAttempts Int @default(0)
    loginCodeHash String?
    loginCodeExpiresAt DateTime?
    loginCodeAttempts Int @default(0)
    passwordChangeCodeHash String?
    passwordChangeCodeExpiresAt DateTime?
    passwordChangeCodeAttempts Int @default(0)
    activeFocusSessionId String? @db.ObjectId
    activeWorkoutSessionId String? @db.ObjectId
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    sentFriendships     Friendship[] @relation("FriendshipRequester")
    receivedFriendships Friendship[] @relation("FriendshipAddressee")
  }

  type AppColorPreset {
    id    String
    name  String
    color String
  }

  enum FriendshipStatus {
    PENDING
    ACCEPTED
  }

  model Friendship {
    id          String           @id @default(auto()) @map("_id") @db.ObjectId
    pairKey     String           @unique
    requesterId String           @db.ObjectId
    addresseeId String           @db.ObjectId
    requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
    status      FriendshipStatus @default(PENDING)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    @@unique([requesterId, addresseeId])
    @@index([addresseeId, status, createdAt])
    @@index([requesterId, status, createdAt])
    @@index([addresseeId, createdAt, id])
    @@index([requesterId, createdAt, id])
  }

  model PendingProfileUpload {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    folder    String
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime @default(now())

    @@index([expiresAt])
  }

  enum Frequency {
    DAILY
    CUSTOM
  }

  model Habit {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    userId       String    @db.ObjectId
    name         String
    description  String?
    category     String?
    icon         String?
    dailyTarget  Int?      @default(1)
    step         Int       @default(1)
    color        String    @default("#c4b5fd")
    frequency    Frequency @default(DAILY)
    daysOfWeek   Int[]
    isActive     Boolean   @default(true)
    startDateKey String
    position     Int?      @default(0)
    timeOfDay    String?
    unit         String?
    currentStreak  Int     @default(0)
    longestStreak  Int     @default(0)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    @@index([userId, isActive])
  }

  model CheckIn {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String   @db.ObjectId
    habitId     String   @db.ObjectId
    completedAt DateTime
    dateKey     String
    occurrence  Int?     @default(1)
    createdAt   DateTime @default(now())

    @@unique([habitId, dateKey])
    @@index([userId, dateKey])
  }

  enum GoalPeriod {
    DAILY
    WEEKLY
    MONTHLY
    CUSTOM
  }

  model Goal {
    id           String     @id @default(auto()) @map("_id") @db.ObjectId
    userId       String     @db.ObjectId
    name         String
    description  String?
    category     String?
    targetValue  Float
    currentValue Float      @default(0)
    unit         String
    period       GoalPeriod @default(MONTHLY)
    isActive     Boolean    @default(true)
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    @@index([userId, isActive])
  }

  enum FocusSessionStatus {
    RUNNING
    PAUSED
    COMPLETED
    CANCELLED
  }

  model FocusSession {
    id             String             @id @default(auto()) @map("_id") @db.ObjectId
    userId         String             @db.ObjectId
    goalId         String?            @db.ObjectId
    title          String
    plannedMinutes Int
    elapsedSeconds Int                @default(0)
    status         FocusSessionStatus @default(RUNNING)
    resumedAt      DateTime?
    completedAt    DateTime?
    cancelledAt    DateTime?
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt

    @@index([userId, status, createdAt])
    @@index([userId, goalId])
  }

  enum AuthChallengePurpose {
    EMAIL_VERIFICATION
    LOGIN
  }

  model AuthChallenge {
    id           String               @id @default(auto()) @map("_id") @db.ObjectId
    userId       String               @db.ObjectId
    purpose      AuthChallengePurpose
    codeHash     String
    expiresAt    DateTime
    consumedAt   DateTime?
    attemptCount Int                  @default(0)
    createdAt    DateTime             @default(now())

    @@index([userId, purpose, createdAt])
    @@index([expiresAt])
  }

  model ReadingBook {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String   @db.ObjectId
    title       String
    author      String?
    isbn        String?
    coverId     Int?
    coverUrl    String?
    totalPages  Int
    currentPage Int      @default(0)
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([userId, isActive])
    @@index([userId, isActive, createdAt])
  }

  model ReadingLog {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String   @db.ObjectId
    bookId      String   @db.ObjectId
    pagesRead   Int
    minutesRead Int
    dateKey     String
    createdAt   DateTime @default(now())

    @@index([bookId, dateKey])
    @@index([userId, dateKey])
    @@index([userId, bookId, createdAt])
    @@index([userId, createdAt, id])
  }

  type WorkoutPlanExercise {
    id           String
    name         String
    order        Int
    plannedSets  Int
    repTarget    String
    restSeconds  Int
  }

  type WorkoutSet {
    id          String
    setNumber   Int
    weight      Float?
    reps        Int?
    completed   Boolean  @default(false)
    completedAt DateTime?
  }

  type WorkoutSessionExercise {
    id           String
    planExerciseId String?
    name         String
    order        Int
    plannedSets  Int
    repTarget    String
    restSeconds  Int
    sets         WorkoutSet[]
  }

  enum WorkoutSessionStatus {
    IN_PROGRESS
    COMPLETED
    ABANDONED
  }

  model WorkoutPlan {
    id        String                 @id @default(auto()) @map("_id") @db.ObjectId
    userId    String                 @db.ObjectId
    name      String
    exercises WorkoutPlanExercise[]
    createdAt DateTime               @default(now())
    updatedAt DateTime               @updatedAt

    @@index([userId, updatedAt])
  }

  model WorkoutSession {
    id          String                   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String                   @db.ObjectId
    planId      String?                  @db.ObjectId
    planName    String?
    status      WorkoutSessionStatus     @default(IN_PROGRESS)
    revision    Int                      @default(0)
    startedAt   DateTime                 @default(now())
    completedAt DateTime?
    abandonedAt DateTime?
    exercises   WorkoutSessionExercise[]
    createdAt   DateTime                 @default(now())
    updatedAt   DateTime                 @updatedAt

    @@index([userId, status, startedAt])
    @@index([userId, completedAt])
    @@index([userId, planId])
  }
