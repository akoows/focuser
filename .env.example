# ===== ObrigatÃ³rias =====
# MongoDB DEVE rodar como replica set (Prisma exige para escrita/transaÃ§Ãµes).
# Atlas SRV descobre os membros do replica set automaticamente; substitua usuario/senha no .env local.
DATABASE_URL=
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (mÃ­n. 32 caracteres)
JWT_SECRET=

# ===== Servidor =====
NODE_ENV=development
PORT=3000
# Origens permitidas (separadas por vÃ­rgula). Sem "*". OBRIGATÃ“RIO em produÃ§Ã£o.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# NÂº de proxies reversos confiÃ¡veis Ã  frente da API (0 = nenhum)
TRUST_PROXY=0

# ===== SessÃ£o (cookie httpOnly) =====
JWT_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false          # use true em produÃ§Ã£o (HTTPS)
COOKIE_SAMESITE=lax          # lax | strict | none (none exige COOKIE_SECURE=true)
BCRYPT_COST=12

# ===== E-mail =====
RESEND_API_KEY=
RESEND_FROM=

# ===== Rate limiting =====
RATE_LIMIT_GLOBAL_MAX=1000   # por IP / 15 min
RATE_LIMIT_LOGIN_MAX=10      # tentativas de login por IP / 15 min
RATE_LIMIT_REGISTER_MAX=10   # cadastros por IP / hora
RATE_LIMIT_AUTH_CODE_MAX=10  # desafios de autenticaÃ§Ã£o por IP / 15 min
RATE_LIMIT_AI_PER_HOUR=5     # chamadas Groq por usuÃ¡rio / hora
RATE_LIMIT_ISBN_LOOKUP_PER_HOUR=20 # buscas de ISBN por usuÃ¡rio / hora
RATE_LIMIT_EXERCISE_IMAGES_PER_HOUR=60

# ===== Groq =====
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=15000

# ===== Fontes adicionais de capas (opcional; funciona sem chave dentro da quota pÃºblica) =====
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_TIMEOUT_MS=8000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=focuser/avatars
